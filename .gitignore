# =========================
# DJANGO / PYTHON
# =========================

# Python cache
backend/__pycache__/
backend/**/*.py[cod]
backend/*$py.class

# Virtual environments
backend/venv/
backend/.venv/
backend/env/
backend/ENV/

# Django database
backend/db.sqlite3
backend/db.sqlite3-journal

# Django collected static files
backend/staticfiles/

# Media uploads (optional)
backend/media/

# Python packaging
backend/build/
backend/dist/
backend/*.egg-info/

# Environment variables
backend/.env

